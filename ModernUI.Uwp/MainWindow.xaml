<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ModernUI.Uwp.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AI Automation Assistant"
    SystemBackdrop="Mica">

    <Grid RowDefinitions="Auto,*,Auto" Padding="16">

        <!-- Header -->
        <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
            <TextBlock Text="AI Automation Assistant"
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="由 Project4 后端驱动 · WinUI 3 (UWP XAML)"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Log output -->
        <Border Grid.Row="1"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8">
            <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LogText"
                           FontFamily="Cascadia Mono, Consolas"
                           FontSize="13"
                           TextWrapping="Wrap"
                           IsTextSelectionEnabled="True"/>
            </ScrollViewer>
        </Border>

        <!-- Input row -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,12,0,0" ColumnSpacing="8">
            <TextBox x:Name="InputBox"
                     Grid.Column="0"
                     PlaceholderText="输入指令，例如：打开记事本 / 保存记事本 …"
                     KeyDown="InputBox_KeyDown"/>
            <Button x:Name="SendButton"
                    Grid.Column="1"
                    Content="执行"
                    Style="{StaticResource AccentButtonStyle}"
                    Click="SendButton_Click"/>
        </Grid>
    </Grid>
</Window>
